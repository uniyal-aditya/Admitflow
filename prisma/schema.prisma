generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  password  String?
  googleId  String?
  phone     String? @unique
  role      String   @default("user") // "user" | "moderator" | "admin"
  isBanned  Boolean  @default(false)
  bannedAt  DateTime?
  banReason String?
  lastLoginAt DateTime?
  referralSource String?
  onboardingCompleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites    Favorite[]
  downloads    Download[]
  suggestions      Suggestion[]
  notifications    Notification[]
  pushSubscriptions PushSubscription[]
  settings         UserSettings?
  reviews      Review[]
  posts        Post[]
  comments     Comment[]
}

model UserSettings {
  id                  String @id @default(cuid())
  userId              String @unique
  notificationTypes   String @default("admission,registration,counselling,spot_round,vacant_seat,merit_list")
  scanFrequency       Int    @default(6)
  language            String @default("en")
  emailNotifications  Boolean @default(false)
  deviceNotifications Boolean @default(false)
  pixelTheme          Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String @id @default(cuid())
  userId    String
  collegeId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
}

model Download {
  id           String @id @default(cuid())
  userId       String
  noticeId     String
  noticeTitle  String
  collegeName  String
  downloadedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  collegeName String
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  noticeId    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Admin {
  id         String   @id @default(cuid())
  email      String   @unique
  role       String   @default("admin") // "superadmin" | "admin"
  addedBy    String?
  totpSecret String?  // TOTP secret for two-factor authentication
  createdAt  DateTime @default(now())
}

model College {
  id              String   @id
  name            String
  shortName       String
  type            String   // "university" | "engineering" | "medical" | etc
  ownership       String   // "government" | "private" | "deemed" | etc
  location        String
  district        String
  website         String?
  admissionPortal String?
  contactPhone    String?
  contactEmail    String?
  description     String?
  established     Int?
  accreditation   String?
  affiliation     String?
  principal       String?
  imageUrl        String?
  courses         Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  notices Notice[]
}

model Notice {
  id               String   @id
  collegeId        String
  title            String
  type             String   // "admission" | "registration" | etc
  publishedDate    String
  lastDate         String?
  status           String   // "active" | "upcoming" | "expired"
  summary          String?
  highlights       Json     @default("[]")
  pdfUrl           String?
  sourceUrl        String?
  coursesAffected  Json     @default("[]")
  branchesAffected Json     @default("[]")
  deadlines        Json     @default("[]")
  documentsRequired Json    @default("[]")
  eligibility      String?
  importantDates   Json     @default("[]")
  aiSummary        String?
  relatedNoticeIds Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([type])
  @@index([status])
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  content   String
  media     Json?    // [{type:"image"|"video"|"gif"|"link", url:"...", thumbnail:"..."}]
  tags      String[] @default([])
  isPinned  Boolean  @default(false)
  isLocked  Boolean  @default(false)
  status    String   @default("approved") // "pending" | "approved" | "rejected" | "deleted"
  moderatedById String?
  moderatedAt   DateTime?
  deleteReason  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([status])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  media     Json?    // optional media in reply
  isEdited  Boolean  @default(false)
  status    String   @default("approved") // "pending" | "approved" | "rejected" | "deleted"
  moderatedById String?
  moderatedAt   DateTime?
  deleteReason  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([status])
}

model BroadcastMessage {
  id        String   @id @default(cuid())
  message   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visitor {
  id             String   @id @default(cuid())
  name           String?
  email          String?
  phone          String?
  referralSource String?
  isPwaUser      Boolean  @default(false)
  userAgent      String?
  createdAt      DateTime @default(now())
}

model AdminLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  adminEmail String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Suggestion {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String
  location    String
  district    String
  website     String
  status      String   @default("pending")
  suggestedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
