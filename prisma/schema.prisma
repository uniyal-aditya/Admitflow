generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  password  String?
  googleId  String?
  phone     String? @unique
  role      String   @default("user") // "user" | "moderator" | "admin"
  isBanned  Boolean  @default(false)
  bannedAt  DateTime?
  banReason String?
  lastLoginAt DateTime?
  referralSource String?
  onboardingCompleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites    Favorite[]
  downloads    Download[]
  suggestions      Suggestion[]
  notifications    Notification[]
  pushSubscriptions PushSubscription[]
  settings         UserSettings?
  reviews      Review[]
  posts        Post[]
  comments     Comment[]
}

model UserSettings {
  id                  String @id @default(cuid())
  userId              String @unique
  notificationTypes   String @default("admission,registration,counselling,spot_round,vacant_seat,merit_list")
  scanFrequency       Int    @default(6)
  language            String @default("en")
  emailNotifications  Boolean @default(false)
  deviceNotifications Boolean @default(false)
  pixelTheme          Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String @id @default(cuid())
  userId    String
  collegeId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
}

model Download {
  id           String @id @default(cuid())
  userId       String
  noticeId     String
  noticeTitle  String
  collegeName  String
  downloadedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  collegeName String
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  noticeId    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Admin {
  id         String   @id @default(cuid())
  email      String   @unique
  role       String   @default("admin") // "superadmin" | "admin"
  addedBy    String?
  totpSecret String?  // TOTP secret for two-factor authentication
  createdAt  DateTime @default(now())
}

model College {
  id              String   @id
  name            String
  shortName       String
  type            String   // "university" | "engineering" | "medical" | etc (legacy free text; enum world lives in the normalized tables below)
  ownership       String   // "government" | "private" | "deemed" | etc (legacy free text)
  location        String
  district        String
  website         String?
  contactPhone    String?
  contactEmail    String?
  description     String?
  established     Int?
  accreditation   String?
  affiliation     String?
  principal       String?
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  notices        Notice[]
  offerings      CourseOffering[]
  sessions       CollegeSession[]
  deadlines      Deadline[]
  facilities     CampusFacility[]
  timelineStages LegacyTimelineStage[]

  @@index([district])
  @@index([type])
  @@index([ownership])
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  content   String
  media     Json?    // [{type:"image"|"video"|"gif"|"link", url:"...", thumbnail:"..."}]
  tags      String[] @default([])
  isPinned  Boolean  @default(false)
  isLocked  Boolean  @default(false)
  status    String   @default("approved") // "pending" | "approved" | "rejected" | "deleted"
  moderatedById String?
  moderatedAt   DateTime?
  deleteReason  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([status])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  media     Json?    // optional media in reply
  isEdited  Boolean  @default(false)
  status    String   @default("approved") // "pending" | "approved" | "rejected" | "deleted"
  moderatedById String?
  moderatedAt   DateTime?
  deleteReason  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([status])
}

model BroadcastMessage {
  id        String   @id @default(cuid())
  message   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visitor {
  id             String   @id @default(cuid())
  name           String?
  email          String?
  phone          String?
  referralSource String?
  isPwaUser      Boolean  @default(false)
  userAgent      String?
  createdAt      DateTime @default(now())
}

model AdminLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  adminEmail String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model Review {
  id        String @id @default(cuid())
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Suggestion {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String
  location    String
  district    String
  website     String
  status      String   @default("pending")
  suggestedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════════════════
// Normalized admission domain (Phase 1 — ADDITIVE).
// Every fact points to a Source via Attribution.
// Nothing is invented; unknown provenance = unverified.
// Naming note (Phase 5): `Notice` below IS the canonical notice table —
// the legacy AI-era Notice model was dropped and this was renamed from
// AdmissionNotice in the Phase 5 migration.
// ═══════════════════════════════════════════════════════════════════════

enum CollegeTypeEnum {
  university
  engineering
  polytechnic
  degree
  diploma
  medical
  management
  pharmacy
  law
  other
}

enum OwnershipEnum {
  government
  private
  aided
  deemed
  autonomous
}

enum NoticeTypeEnum {
  admission
  registration
  counselling
  spot_round
  vacant_seat
  merit_list
  waiting_list
  fee_payment
  reporting
  extension
  general
}

enum EditorialStatus {
  draft
  published
  archived
}

enum SourceKind {
  official
  news
  user_report
  internal
}

enum VerificationState {
  unverified
  verified
  deprecated
}

enum DeadlineEvent {
  registration_open
  registration_close
  merit_list
  choice_filling
  seat_allotment
  fee_payment
  reporting
  counselling_round
  spot_round
  result
  classes_begin
  other
  waiting_list
}

enum ScopeType {
  college
  offering
  authority
}

enum FeeComponent {
  tuition
  hostel
  exam
  one_time
  other
}

enum FeeFrequency {
  per_year
  per_semester
  total
}

enum ProgramLevel {
  diploma
  undergraduate
  postgraduate
  doctoral
}

model Source {
  id            String            @id @default(cuid())
  name          String
  url           String?
  kind          SourceKind        @default(official)
  verification  VerificationState @default(unverified)
  lastCheckedAt DateTime?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  attributions Attribution[]

  @@unique([name, url])
}

model Attribution {
  id              String  @id @default(cuid())
  sourceId        String
  source          Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  entityType      String
  entityId        String
  fieldPath       String?
  verifiedByAdmin String?
  verifiedAt      DateTime?

  @@index([entityType, entityId])
  @@index([sourceId])
}

model AcademicSession {
  id    Int    @id @default(autoincrement())
  year  Int    @unique
  label String

  offerings CourseOffering[]
  fees      FeeStructure[]
  routes    AdmissionRoute[]
  notices   Notice[]
  deadlines Deadline[]
}

model Program {
  id       String       @id
  name     String       @unique
  level    ProgramLevel @default(undergraduate)
  keywords String[]     @default([])

  offerings CourseOffering[]
}

model Branch {
  id      String   @id
  name    String   @unique
  aliases String[] @default([])

  offerings CourseOffering[]
}

model CollegeSession {
  id        String  @id @default(cuid())
  collegeId String
  year      Int
  notes     String?

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, year])
}

model CampusFacility {
  id        String   @id @default(cuid())
  collegeId String   @unique
  hostel    Boolean?

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model CourseOffering {
  id            String   @id @default(cuid())
  collegeId     String
  programId     String
  branchId      String?
  sessionYear   Int
  durationYears Float?
  durationLabel String?
  totalSeats    Int?
  eligibility   String?

  college   College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  program   Program         @relation(fields: [programId], references: [id], onDelete: Restrict)
  branch    Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  session   AcademicSession @relation(fields: [sessionYear], references: [year])
  fees      FeeStructure[]
  routes    AdmissionRoute[]
  deadlines Deadline[]

  @@unique([collegeId, programId, branchId, sessionYear])
  @@index([programId])
  @@index([branchId])
  @@index([sessionYear])
  @@index([collegeId])
}

model FeeStructure {
  id          String       @id @default(cuid())
  offeringId  String
  component   FeeComponent @default(tuition)
  amountPaise Int
  frequency   FeeFrequency @default(per_year)
  sessionYear Int

  offering CourseOffering  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  session  AcademicSession @relation(fields: [sessionYear], references: [year])

  @@unique([offeringId, component, sessionYear])
  @@index([sessionYear])
}

model EntranceExam {
  id             String   @id
  name           String   @unique
  aliases        String[] @default([])
  conductingBody String?

  routes AdmissionRoute[]
}

model CounsellingAuthority {
  id      String  @id
  name    String  @unique
  website String?
  state   String?

  routes           AdmissionRoute[]
  deadlines        Deadline[]
  notices          Notice[]
}

model AdmissionRoute {
  id                    String  @id @default(cuid())
  offeringId            String
  sessionId             Int
  examId                String?
  authorityId           String?
  eligibilityText       String?
  eligibilityStructured Json?

  offering  CourseOffering        @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  session   AcademicSession       @relation(fields: [sessionId], references: [year])
  exam      EntranceExam?         @relation(fields: [examId], references: [id])
  authority CounsellingAuthority? @relation(fields: [authorityId], references: [id])

  @@unique([offeringId, examId, authorityId])
  @@index([examId])
  @@index([authorityId])
}

model Deadline {
  id             String        @id @default(cuid())
  scopeType      ScopeType
  collegeId      String?
  offeringId     String?
  authorityId    String?
  eventId        DeadlineEvent
  label          String
  startsAt       DateTime?
  endsAt         DateTime?
  sessionId      Int
  statusOverride String?

  college   College?              @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  offering  CourseOffering?       @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  authority CounsellingAuthority? @relation(fields: [authorityId], references: [id], onDelete: Cascade)
  session   AcademicSession       @relation(fields: [sessionId], references: [year])

  @@index([scopeType, endsAt])
  @@index([collegeId])
  @@index([offeringId])
  @@index([authorityId])
}

model Notice {
  id                String          @id
  collegeId         String?
  authorityId       String?
  sessionId         Int
  title             String
  summary           String?
  type              NoticeTypeEnum
  publishedAt       DateTime?
  officialUrl       String?
  pdfUrl            String?
  status            EditorialStatus @default(published)
  documentsRequired String[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  college   College?              @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  authority CounsellingAuthority? @relation(fields: [authorityId], references: [id])
  session   AcademicSession       @relation(fields: [sessionId], references: [year])
  dates     NoticeDate[]

  @@index([publishedAt])
  @@index([type])
  @@index([collegeId])
}

model NoticeDate {
  id       String   @id @default(cuid())
  noticeId String
  kind     String
  label    String
  date     DateTime

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([noticeId])
  @@index([date])
}

model LegacyTimelineStage {
  id          String        @id @default(cuid())
  collegeId   String
  eventId     DeadlineEvent
  label       String
  date        DateTime?
  rawStageKey String
  rawStatus   String?
  description String?
  sortOrder   Int

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, sortOrder])
}
