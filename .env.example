# ─── Required ────────────────────────────────────────────────────────────
# Postgres connection string (Neon or compatible). Quotes optional.
DATABASE_URL=

# Session signing secret (openssl rand -base64 32). Required — the app
# refuses to boot without it.
JWT_SECRET=

# Superadmin identity: this email gets superadmin role via /lib/admin.
ADMIN_EMAIL=

# ─── Optional integrations ───────────────────────────────────────────────
# Google OAuth (sign-in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM features (chat assistant, admin data verification)
# provider: openrouter (default) | openai | google
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Transactional email (Brevo SMTP by default)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# GIF picker (Klipy)
KLIPY_API_KEY=

# Public base URL used in notification links
NEXT_PUBLIC_URL=
