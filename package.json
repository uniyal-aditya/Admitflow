{
  "name": "admitflow",
  "version": "1.0.0",
  "description": "The Ultimate Uttarakhand Government College Admission Companion",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --env-file=.env --test tests/*.test.ts",
    "test:unit": "tsx --test tests/deadline.test.ts",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy:retry": "tsx scripts/deploy-migration.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "data:seed:dry-run": "tsx scripts/migrate-seed.ts --dry-run",
    "data:seed": "tsx scripts/migrate-seed.ts",
    "data:verify": "tsx scripts/migrate-seed.ts --verify"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.9",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.18",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "google-auth-library": "^10.9.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.510.0",
    "next": "^15.3.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
